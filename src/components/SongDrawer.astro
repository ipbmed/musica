---
import { withBase } from '../lib/paths';

interface SongItem {
	id: string;
	title: string;
	kind: 'hino' | 'cantico';
	number?: number;
}

interface Props {
	songs: SongItem[];
	currentId: string;
}

const { songs, currentId } = Astro.props;
const alphabet = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'];

function titleLetter(title: string) {
	const normalized = title
		.trim()
		.normalize('NFD')
		.replace(/\p{M}/gu, '')
		.toUpperCase();
	const letter = normalized.charAt(0);
	return /[A-Z]/.test(letter) ? letter : '#';
}
---

<div class="song-drawer" id="song-drawer" data-song-drawer data-open="false">
	<button type="button" class="drawer-backdrop" data-drawer-close tabindex="-1" aria-label="Fechar lista"></button>

	<aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
		<header class="drawer-header">
			<div>
				<p class="drawer-kicker">Trocar música</p>
				<h2 id="drawer-title">Lista</h2>
			</div>
			<button type="button" class="drawer-close" data-drawer-close aria-label="Fechar">
				✕
			</button>
		</header>

		<details class="drawer-filters" data-drawer-filters>
			<summary class="drawer-filters-toggle">
				<span class="drawer-filters-label">Filtros</span>
				<span class="drawer-filters-action" data-drawer-filters-action>Expandir</span>
			</summary>

			<div class="drawer-filters-body">
				<div class="kind-filters" role="group" aria-label="Filtrar por tipo">
					<button type="button" class="filter-btn" data-drawer-kind="todos" aria-pressed="true">Todos</button>
					<button type="button" class="filter-btn" data-drawer-kind="hino" aria-pressed="false">Hinos</button>
					<button type="button" class="filter-btn" data-drawer-kind="cantico" aria-pressed="false">Cânticos</button>
				</div>

				<div class="sort-filters" role="group" aria-label="Ordenar por">
					<button type="button" class="filter-btn" data-drawer-sort="numero" aria-pressed="true">Número</button>
					<button type="button" class="filter-btn" data-drawer-sort="titulo" aria-pressed="false">Título</button>
				</div>

				<div class="letter-filters" role="group" aria-label="Filtrar por letra">
					<button type="button" class="letter-btn" data-drawer-letter="todos" aria-pressed="true">
						Todas
					</button>
					{
						alphabet.map((letter) => (
							<button type="button" class="letter-btn" data-drawer-letter={letter} aria-pressed="false">
								{letter}
							</button>
						))
					}
				</div>
			</div>
		</details>

		<div class="drawer-search">
			<label class="visually-hidden" for="drawer-search">Buscar na lista</label>
			<input
				id="drawer-search"
				type="search"
				placeholder="Buscar título ou número"
				autocomplete="off"
				inputmode="search"
				data-drawer-search
			/>
		</div>

		<ul class="drawer-list" role="list" data-drawer-list>
			{
				songs.map((song) => {
					const search = [song.title, song.number, song.kind, song.kind === 'hino' ? 'hino' : 'cântico']
						.filter(Boolean)
						.join(' ')
						.toLowerCase();
					const current = song.id === currentId;

					return (
						<li
							data-drawer-item
							data-search={search}
							data-kind={song.kind}
							data-number={song.number ?? ''}
							data-title={song.title}
							data-letter={titleLetter(song.title)}
						>
							<a
								class:list={['drawer-link', { 'is-current': current }]}
								href={withBase(`musica/${song.id}/`)}
								aria-current={current ? 'page' : undefined}
							>
								<span class="drawer-meta">
									<span class="song-kind-row">
										<span class="drawer-kind">{song.kind === 'hino' ? 'Hino' : 'Cântico'}</span>
										{song.number !== undefined && (
											<span class="song-num-badge">{song.number}</span>
										)}
									</span>
									<span class="drawer-title">{song.title}</span>
								</span>
							</a>
						</li>
					);
				})
			}
		</ul>

		<p class="drawer-empty" data-drawer-empty hidden>Nenhuma música encontrada.</p>
	</aside>
</div>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	import { initSongDrawer } from '../scripts/songDrawer';
	initSongDrawer();
</script>
