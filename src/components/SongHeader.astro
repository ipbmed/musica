---
import ReaderToolbar from './ReaderToolbar.astro';
import SongDrawer from './SongDrawer.astro';
import { withBase } from '../lib/paths';

interface SongItem {
	id: string;
	title: string;
	kind: 'hino' | 'cantico';
	number?: number;
}

interface Props {
	songs: SongItem[];
	currentId: string;
}

const { songs, currentId } = Astro.props;
const homeHref = withBase();
---

<header class="app-bar">
	<button
		type="button"
		class="drawer-launch"
		data-drawer-open
		aria-expanded="false"
		aria-controls="song-drawer"
	>
		<span aria-hidden="true">☰</span>
		<span class="visually-hidden">Abrir lista de músicas</span>
	</button>

	<a class="brand-lockup brand-lockup--compact" href={homeHref}>
		<img class="logo" src={withBase('logo.png')} alt="Igreja Presbiteriana do Brasil" width="36" height="29" />
		<span class="brand-text">
			IPB Med
			<small>Música</small>
		</span>
	</a>

	<button
		type="button"
		class="musician-toggle"
		data-musician-toggle
		aria-pressed="false"
		title="Modo músico"
	>
		<span aria-hidden="true">♪</span>
		<span class="visually-hidden">Alternar modo músico</span>
	</button>

	<ReaderToolbar />
</header>

<!-- Fora do app-bar: backdrop-filter cria containing block e quebrava o fixed da gaveta -->
<SongDrawer songs={songs} currentId={currentId} />

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	import { initMusicianMode } from '../scripts/musicianMode';
	initMusicianMode();
</script>
