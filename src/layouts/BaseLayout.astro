---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	home?: boolean;
}

const {
	title,
	description = 'Letras de músicas da Igreja Presbiteriana de Medianeira.',
	home = false,
} = Astro.props;
const pageTitle = title === 'IPB Med' ? 'IPB Med · Letras' : `${title} · IPB Med`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}favicon-ipb.png`} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fafbfa" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Literata:opsz,wght@7..72,500;7..72,600;7..72,700&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<script is:inline>
			(() => {
				try {
					const raw = localStorage.getItem('ipbmed-reader-prefs');
					if (!raw) return;
					const prefs = JSON.parse(raw);
					const root = document.documentElement;
					if (prefs.size) root.dataset.textSize = String(prefs.size);
					if (prefs.contrast) root.dataset.contrast = prefs.contrast;
					if (prefs.font) root.dataset.font = prefs.font;
				} catch {}
			})();
		</script>
	</head>
	<body class:list={[{ 'is-home': home }]}>
		{
			home && (
				<section class="church-hero" aria-label="Fachada da igreja">
					<img
						src={`${base}images/igreja.jpg`}
						alt="Fachada da Igreja Presbiteriana de Medianeira"
						width="1600"
						height="900"
						fetchpriority="high"
					/>
				</section>
			)
		}
		<div class="shell">
			<slot />
			{
				home && (
					<footer class="site-footer">
						<div class="footer-brand">
							<img class="logo logo--footer" src={`${base}logo.png`} alt="Igreja Presbiteriana do Brasil" width="44" height="36" />
							<p>
								<strong>IPB Med</strong>
								<br />
								Igreja Presbiteriana de Medianeira
							</p>
						</div>
					</footer>
				)
			}
		</div>
	</body>
</html>
