---
import '../styles/global.css';
import ReaderToolbar from '../components/ReaderToolbar.astro';
import { withBase } from '../lib/paths';

interface Props {
	title: string;
	description?: string;
	home?: boolean;
	/** Se a música tem versões do modo músico. */
	hasMusicianVersions?: boolean;
}

const {
	title,
	description = 'Músicas da Igreja Presbiteriana de Medianeira.',
	home = false,
	hasMusicianVersions = false,
} = Astro.props;
const pageTitle = title === 'IPB Med' ? 'IPB Med · Música' : `${title} · IPB Med`;
const base = withBase();
---

<!doctype html>
<html
	lang="pt-BR"
	data-list-view="todas"
	data-has-musician-versions={hasMusicianVersions ? 'true' : 'false'}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon.png')} />
		<link rel="icon" type="image/png" sizes="192x192" href={withBase('icons/icon-192.png')} />
		<link rel="shortcut icon" href={withBase('favicon.ico')} />
		<link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
		<link rel="manifest" href={withBase('manifest.webmanifest')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0f5c52" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="IPB Med Música" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Literata:opsz,wght@7..72,500;7..72,600;7..72,700&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<script is:inline>
			(() => {
				try {
					const root = document.documentElement;
					const raw = localStorage.getItem('ipbmed-reader-prefs');
					if (raw) {
						const prefs = JSON.parse(raw);
						if (prefs.size) root.dataset.textSize = String(prefs.size);
						if (prefs.contrast) root.dataset.contrast = prefs.contrast;
						if (prefs.font) root.dataset.font = prefs.font;
					}
					root.dataset.musician = localStorage.getItem('ipbmed-musician-mode') === '1' ? 'on' : 'off';
					if (!root.dataset.listView) root.dataset.listView = 'todas';
				} catch {
					document.documentElement.dataset.listView = 'todas';
				}
			})();
		</script>
	</head>
	<body class:list={[{ 'is-home': home }]}>
		{
			home && (
				<section class="church-hero" aria-label="Fachada da igreja">
					<div class="church-hero-media">
						<img
							src={withBase('images/igreja.jpg')}
							alt="Fachada da Igreja Presbiteriana de Medianeira"
							width="1600"
							height="900"
							fetchpriority="high"
						/>
					</div>
					<div class="church-hero-tools">
						<ReaderToolbar />
					</div>
				</section>
			)
		}
		<div class="shell">
			<slot />
			{
				home && (
					<footer class="site-footer">
						<div class="footer-brand">
							<img class="logo logo--footer" src={withBase('logo.png')} alt="Igreja Presbiteriana do Brasil" width="44" height="36" />
							<p>
								<strong>IPB Med</strong>
								<br />
								Igreja Presbiteriana de Medianeira
							</p>
						</div>
					</footer>
				)
			}
		</div>
		<script is:inline define:vars={{ swUrl: withBase('sw.js'), swScope: base }}>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => {});
				});
			}
		</script>
	</body>
</html>
