---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const songs = (await getCollection('songs')).sort((a, b) => {
	const aNum = a.data.number ?? Number.POSITIVE_INFINITY;
	const bNum = b.data.number ?? Number.POSITIVE_INFINITY;
	if (aNum !== bNum) return aNum - bNum;
	return a.data.title.localeCompare(b.data.title, 'pt-BR');
});

const alphabet = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'];

function titleLetter(title: string) {
	const normalized = title
		.trim()
		.normalize('NFD')
		.replace(/\p{M}/gu, '')
		.toUpperCase();
	const letter = normalized.charAt(0);
	return /[A-Z]/.test(letter) ? letter : '#';
}

const homeHref = withBase();
---

<BaseLayout title="IPB Med" description="Músicas da Igreja Presbiteriana de Medianeira." home>
	<header class="site-header">
		<div class="site-header-top">
			<a class="brand-lockup" href={homeHref}>
				<img class="logo" src={withBase('logo.png')} alt="Igreja Presbiteriana do Brasil" width="72" height="58" />
				<span class="brand-text">
					IPB Med
					<small>Música</small>
				</span>
			</a>
			<div class="site-header-actions">
				<button
					type="button"
					class="fav-filter-btn"
					data-fav-filter
					aria-pressed="false"
					title="Mostrar somente o repertório"
				>
					<span aria-hidden="true">☆</span>
					<span class="fav-filter-text">Repertório</span>
					<span class="fav-count" data-fav-count>0</span>
				</button>
			</div>
		</div>
		<div class="tagline-row">
			<p class="tagline">Igreja Presbiteriana de Medianeira</p>
			<nav class="social-links" aria-label="Redes sociais">
				<a href="https://www.instagram.com/ipbmedianeira/" target="_blank" rel="noopener noreferrer">
					Instagram
				</a>
				<a href="https://www.facebook.com/ipbmedianeira" target="_blank" rel="noopener noreferrer">
					Facebook
				</a>
				<a href="https://www.youtube.com/c/IPBMedianeira" target="_blank" rel="noopener noreferrer">
					YouTube
				</a>
			</nav>
		</div>
	</header>

	<div class="toolbar">
		<div data-catalog-filters class="catalog-filters">
			<div class="kind-filters" role="group" aria-label="Filtrar por tipo">
				<button type="button" class="filter-btn" data-kind-filter="todos" aria-pressed="true">Todos</button>
				<button type="button" class="filter-btn" data-kind-filter="hino" aria-pressed="false">Hinos</button>
				<button type="button" class="filter-btn" data-kind-filter="cantico" aria-pressed="false">Cânticos</button>
			</div>

			<div class="sort-filters" role="group" aria-label="Ordenar por">
				<button type="button" class="filter-btn" data-sort-mode="numero" aria-pressed="true">Número</button>
				<button type="button" class="filter-btn" data-sort-mode="titulo" aria-pressed="false">Título</button>
			</div>

			<div class="letter-filters" role="group" aria-label="Filtrar por letra">
				<button type="button" class="letter-btn" data-letter-filter="todos" aria-pressed="true">
					Todas
				</button>
				{
					alphabet.map((letter) => (
						<button type="button" class="letter-btn" data-letter-filter={letter} aria-pressed="false">
							{letter}
						</button>
					))
				}
			</div>
		</div>

		<div class="fav-actions" data-fav-actions hidden>
			<p class="fav-hint">Até 20 músicas neste aparelho. Use as setas para ordenar ou compartilhe o link.</p>
			<div class="fav-action-row">
				<button type="button" class="filter-btn fav-share" data-fav-share disabled>Compartilhar</button>
				<button type="button" class="filter-btn fav-clear" data-fav-clear disabled>Limpar</button>
			</div>
		</div>
	</div>

	<div class="search">
		<label class="visually-hidden" for="song-search">Buscar música</label>
		<input
			id="song-search"
			type="search"
			placeholder="Buscar título, número ou tag"
			autocomplete="off"
			inputmode="search"
			data-song-search
		/>
	</div>

	<ul class="song-list" role="list" data-song-list>
		{
			songs.map((song) => {
				const search = [
					song.data.title,
					song.data.number,
					song.data.kind,
					song.data.kind === 'hino' ? 'hino' : 'cantico',
					song.data.kind === 'cantico' ? 'cântico' : '',
					...(song.data.tags ?? []),
				]
					.filter(Boolean)
					.join(' ')
					.toLowerCase();

				return (
					<li
						class="song-row"
						data-song-item
						data-song-id={song.id}
						data-search={search}
						data-kind={song.data.kind}
						data-number={song.data.number ?? ''}
						data-title={song.data.title}
						data-letter={titleLetter(song.data.title)}
					>
						<button
							type="button"
							class="fav-btn"
							data-fav-toggle
							data-song-id={song.id}
							aria-pressed="false"
							title="Adicionar ao repertório"
						>
							<span aria-hidden="true">☆</span>
							<span class="visually-hidden">Adicionar ou remover do repertório</span>
						</button>

						<a class="song-link" href={withBase(`musica/${song.id}/`)}>
							<span class="song-meta">
								<span class="song-kind-row">
									<span class="song-kind">{song.data.kind === 'hino' ? 'Hino' : 'Cântico'}</span>
									{song.data.number !== undefined && (
										<span class="song-num-badge">{song.data.number}</span>
									)}
								</span>
								<span class="song-title">{song.data.title}</span>
							</span>
							<span class="song-chevron" aria-hidden="true">›</span>
						</a>

						<div class="fav-order" data-fav-order>
							<button type="button" class="fav-order-btn" data-fav-up aria-label="Subir no repertório">
								↑
							</button>
							<button type="button" class="fav-order-btn" data-fav-down aria-label="Descer no repertório">
								↓
							</button>
							<button type="button" class="fav-order-btn fav-order-btn--remove" data-fav-remove aria-label="Remover do repertório">
								✕
							</button>
						</div>
					</li>
				);
			})
		}
	</ul>

	<p class="empty-state" data-empty-state hidden>Nenhuma música encontrada.</p>

	<dialog class="rep-import-dialog" data-rep-share>
		<form method="dialog" class="rep-import-panel">
			<h2 class="rep-import-title">Compartilhar repertório</h2>
			<p class="rep-import-text">
				Será gerado um texto com a lista de músicas e um link. Quem abrir o link poderá
				importar este repertório no app.
			</p>
			<label class="rep-share-field">
				<span class="rep-share-label">Finalidade (opcional)</span>
				<input
					type="text"
					name="finalidade"
					maxlength="80"
					placeholder="Ex.: Culto domingo, Casamento…"
					autocomplete="off"
					data-rep-share-purpose
				/>
			</label>
			<p class="rep-share-list-heading">Músicas</p>
			<ol class="rep-share-list" data-rep-share-list></ol>
			<div class="rep-import-actions">
				<button type="submit" class="filter-btn fav-share" value="share">Compartilhar</button>
				<button type="submit" class="filter-btn fav-clear" value="cancel">Cancelar</button>
			</div>
		</form>
	</dialog>

	<dialog class="rep-import-dialog" data-rep-import>
		<form method="dialog" class="rep-import-panel">
			<h2 class="rep-import-title">Importar repertório</h2>
			<p class="rep-import-text" data-rep-import-purpose-wrap hidden>
				Finalidade: <strong data-rep-import-purpose></strong>
			</p>
			<p class="rep-import-text">
				Já existem músicas no repertório. O link traz
				<strong data-rep-import-count>0</strong>
				música(s). O que deseja fazer?
			</p>
			<div class="rep-import-actions">
				<button type="submit" class="filter-btn fav-share" value="add">Adicionar novas</button>
				<button type="submit" class="filter-btn" value="replace">Substituir existentes</button>
				<button type="submit" class="filter-btn fav-clear" value="cancel">Cancelar</button>
			</div>
		</form>
	</dialog>
</BaseLayout>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	import { initSongSearch } from '../scripts/search';
	initSongSearch();
</script>
