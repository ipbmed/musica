---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SongHeader from '../../components/SongHeader.astro';

export async function getStaticPaths() {
	const songs = await getCollection('songs');
	return songs.map((song) => ({
		params: { slug: song.id },
		props: { song },
	}));
}

const { song } = Astro.props;
const { Content } = await render(song);
const base = import.meta.env.BASE_URL;

const songs = (await getCollection('songs'))
	.map((entry) => ({
		id: entry.id,
		title: entry.data.title,
		kind: entry.data.kind,
		number: entry.data.number,
	}))
	.sort((a, b) => {
		const aNum = a.number ?? Number.POSITIVE_INFINITY;
		const bNum = b.number ?? Number.POSITIVE_INFINITY;
		if (aNum !== bNum) return aNum - bNum;
		return a.title.localeCompare(b.title, 'pt-BR');
	});
---

<BaseLayout title={song.data.title} description={`Letra: ${song.data.title} — IPB Med`}>
	<SongHeader songs={songs} currentId={song.id} />

	<a class="back-link" href={base}>‹ Todas as músicas</a>

	<header class="song-hero">
		<p class="eyebrow">
			{
				song.data.kind === 'hino'
					? `Hino Nº ${song.data.number}`
					: song.data.number !== undefined
						? `Cântico · Nº ${song.data.number}`
						: 'Cântico'
			}
		</p>
		<h1>{song.data.title}</h1>
		{song.data.artist && <p class="song-artist">{song.data.artist}</p>}
	</header>

	{
		song.data.links.length > 0 && (
			<nav class="links" aria-label="Links da música">
				{song.data.links.map((link) => (
					<a href={link.url} target="_blank" rel="noopener noreferrer">
						{link.label}
					</a>
				))}
			</nav>
		)
	}

	<article class="lyrics" data-lyrics>
		<Content />
	</article>
</BaseLayout>
